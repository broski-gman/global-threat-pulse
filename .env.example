# Copy to .env.local for local work. Never commit values.
# Each variable lists the milestone that first needs it.

# --- Feeds, phase 1 ---
# Project contact details sent in the feed User-Agent. SANS ISC asks API users for this. (M0, optional)
FEED_CONTACT=
# Optional, but raises the NVD limit from 5 to 50 requests per 30 seconds. (M0)
NVD_API_KEY=
# Free PRO key from ransomware.live, sent as X-API-KEY. (M0)
RANSOMWARE_LIVE_API_KEY=
# Cloudflare API token with Radar read access. (M0)
CLOUDFLARE_API_TOKEN=

# --- Platform ---
# Neon Postgres connection string. (M1)
DATABASE_URL=
# Shared secret for ingest and score routes: Authorization: Bearer <value>. (M1)
CRON_SECRET=
# Private Vercel Blob store token for snapshots. (M2)
BLOB_READ_WRITE_TOKEN=
# Lets GitHub Actions reach routes on protected Vercel deployments. (M4)
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Feeds, phase 2 (M5) ---
# Read-only token for repository stats.
GITHUB_TOKEN=
# abuse.ch Auth-Key for ThreatFox.
ABUSECH_AUTH_KEY=
